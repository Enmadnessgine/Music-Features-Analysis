.scroll--off-dialog {
    -ms-overflow-style: none;
    /* IE and Edge */
    scrollbar-width: none;
    /* Firefox */
    overflow-y: hidden;
    height: 100dvh;
    position: fixed;
}

/* Hide scrollbar for Chrome, Safari and Opera */
.scroll--off-dialog::-webkit-scrollbar {
    display: none;
}

